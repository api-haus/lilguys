{
  "name": "lilguys-office",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE",
        "class_name": "Office"
      },
      {
        "name": "DISCORD",
        "class_name": "Discord"
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Office"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Discord"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "Telegram"
      ]
    }
  ],
  "vars": {
    "OFFICE_URL": "https://lilguys-office.yura415.workers.dev",
    "MIRROR_PEOPLE": false,
    "ANNOUNCE_ARRIVALS": false
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
